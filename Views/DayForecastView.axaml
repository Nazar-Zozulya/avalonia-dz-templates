<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:avalonia_dz_templates.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="250" d:Width="800" d:Height="250"
             x:Class="avalonia_dz_templates.Views.DayForecastView"
             x:DataType="vm:CityViewModel">

    <Border Background="#22000000" CornerRadius="15" Height="200" Width="800" Margin="0,0,0,0">
        <Grid RowDefinitions="Auto, Auto, *">
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="20,15,0,10">
                <TextBlock Text="Прогноз на 24 години" Foreground="White" Opacity="0.9" FontSize="16" />
            </StackPanel>

            <Border Grid.Row="1" Height="1" Background="White" Opacity="0.2" Margin="0,0,0,10" />

            <Grid Grid.Row="2" ColumnDefinitions="*">
                <Grid RowDefinitions="Auto,*">
                    <!-- Верхний список с иконками -->
                    <ItemsControl ItemsSource="{Binding Allah}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="5"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Image Source="avares://avalonia-dz-templates/Assets/sun-with-clouds.png" Height="30"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Нижний график с бордером -->
                    <Border Grid.Row="1" Margin="10" BorderBrush="#000" BorderThickness="1" CornerRadius="8" Padding="5">
                        <ItemsControl ItemsSource="{Binding ForecastFor12H}" VerticalAlignment="Stretch">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Bottom"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="8" Background="Green" CornerRadius="2"
                                            VerticalAlignment="Bottom" Height="{Binding}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>

                </Grid>
            </Grid>
        </Grid>
    </Border>
</UserControl>
